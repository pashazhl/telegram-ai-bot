{
  "name": "telegram-ai-bot",
  "version": "1.3.0",
  "description": "Многофункциональный Telegram-бот с AI на Node.js (Telegraf + OpenRouter + SQLite)",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "migrate": "node scripts/migrate-json-to-sqlite.js",
    "check": "node -e \"require('./src/bot').buildBot()\"",
    "lint:syntax": "find . -path ./node_modules -prune -o -name '*.js' -print | xargs -n1 node --check"
  },
  "keywords": [
    "telegram",
    "bot",
    "ai",
    "openrouter",
    "telegraf",
    "sqlite"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "axios": "^1.16.0",
    "better-sqlite3": "^11.7.0",
    "dotenv": "^17.4.2",
    "express": "^4.22.1",
    "node-cron": "^4.2.1",
    "openai": "^6.35.0",
    "telegraf": "^4.16.3"
  }
}
