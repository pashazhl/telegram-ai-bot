# ============================================================================
# Telegram AI Bot — пример переменных окружения
# Скопируй этот файл в .env и заполни значения. .env в git не коммитится.
# ============================================================================

# Обязательные ----------------------------------------------------------------

# Токен от @BotFather в Telegram
BOT_TOKEN=

# Ключ от https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Ключ от https://openweathermap.org/api
WEATHER_API_KEY=

# Безопасность ----------------------------------------------------------------

# Твой Telegram ID (узнать через @userinfobot). Используется для:
#   - утреннего оповещения о погоде
#   - whitelist (если ALLOWED_USER_IDS пуст — пропускают только тебя)
MY_TELEGRAM_ID=

# Дополнительные разрешённые ID через запятую (например, для друзей).
# Если и это, и MY_TELEGRAM_ID пусты — бот доступен любому (НЕ рекомендуется).
ALLOWED_USER_IDS=

# Токен для веб-панели (Bearer-заголовок). Сгенерируй случайный, например:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

# Настройки (опциональные, со значениями по умолчанию) -----------------------

# Город для утренней погоды
MORNING_CITY=Minsk

# Cron-расписание утренней погоды (минуты часы день месяц день_недели)
MORNING_CRON=30 6 * * *

# Часовой пояс для cron-задач
TZ=Europe/Minsk

# Сколько последних сообщений хранить в истории на пользователя
HISTORY_LIMIT=20

# Модели OpenRouter
AI_MODEL=openrouter/auto
VISION_MODEL=google/gemini-2.0-flash-exp:free

# Где хранить SQLite-базу
DATA_DIR=data
DB_FILE=data/bot.db

# Порт веб-панели (если включена)
WEB_PORT=3000

# Опционально: OpenAI ключ для распознавания голосовых (Whisper)
# OPENAI_API_KEY=
